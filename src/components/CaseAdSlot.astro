---
/**
 * Phone-case cross-promo slot — RETIRED on this site (2026-10 CRO phase 0/1).
 *
 * Kept as a no-op so any remaining call site keeps type-checking; it renders
 * nothing. The editorial promise is "no brand sponsorships".
 */
export interface Props {
  size: '300x250' | '728x90' | '320x50' | '160x600' | '300x600';
  placement?: string;
  /** Pin one store (skips rotation for this slot). */
  shop?: string;
  /** Kids / family gift copy overlay. */
  kids?: boolean;
  /** Full composite JPG banner (no stretched text bar). */
  composite?: boolean;
}

const { size, placement = 'default', shop, kids = false, composite = false } = Astro.props;
void size; void placement; void shop; void kids; void composite;
