---
/**
 * Section pages: phone-case promoted slots are retired on this site.
 *
 * Kept as a no-op component so page/layout call sites (sectionAds props)
 * keep type-checking without rendering any sponsored placement. The site's
 * "no brand sponsorships" editorial claim stays true.
 */
import type { SectionPage } from '@/lib/section-page';

export type { SectionPage };

export interface Props {
  page: SectionPage;
  variant?: 'header' | 'footer' | 'both';
  /** Index/list pages: skip ornament and tighten ad margins */
  compact?: boolean;
}

const { page, variant = 'both', compact = false } = Astro.props;
void page; void variant; void compact;
---

